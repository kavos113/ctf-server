{
  "name": "client",
  "description": "An Aurelia 2 client application.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "???"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aurelia/kernel": "2.0.0-rc.2",
    "@aurelia/platform-browser": "2.0.0-rc.2",
    "@aurelia/router": "latest",
    "@aurelia/runtime-html": "2.0.0-rc.2",
    "aurelia": "latest"
  },
  "devDependencies": {
    "@aurelia/metadata": "2.0.0-rc.2",
    "@aurelia/testing": "latest",
    "@aurelia/vite-plugin": "latest",
    "@eslint/js": "9.39.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "8.58.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.8",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "lint:js": "eslint \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" \"mock/**/*.mjs\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "fmt": "prettier --write \"src/**/*.{js,ts,css,html}\" \"test/**/*.{js,ts,css,html}\"",
    "pretest": "npm run lint",
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../docs/openapi.yaml -o src/api/generated/schema.ts",
    "check:api": "openapi-typescript ../docs/openapi.yaml -o src/api/generated/schema.ts --check",
    "mock": "node mock/server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vitest.json"
  },
  "type": "module"
}
