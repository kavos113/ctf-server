{
  "name": "client",
  "description": "An Aurelia 2 client application.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "???"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aurelia/kernel": "2.0.0-rc.2",
    "@aurelia/platform-browser": "2.0.0-rc.2",
    "@aurelia/router": "latest",
    "@aurelia/runtime-html": "2.0.0-rc.2",
    "aurelia": "latest",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@aurelia/metadata": "2.0.0-rc.2",
    "@aurelia/testing": "latest",
    "@aurelia/vite-plugin": "latest",
    "@types/node": "catalog:",
    "jsdom": "^25.0.1",
    "openapi-typescript": "catalog:",
    "tslib": "^2.8.1",
    "typescript": "catalog:",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "catalog:"
  },
  "scripts": {
    "lint:js": "oxlint --config ../.oxlintrc.json --deny-warnings src test mock *.config.ts",
    "lint:css": "stylelint --config ../.stylelintrc.json \"src/**/*.css\"",
    "lint": "pnpm lint:js && pnpm lint:css",
    "fmt": "oxfmt --config ../.oxfmtrc.json --write src test mock *.config.ts package.json tsconfig*.json",
    "pretest": "pnpm lint",
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../docs/openapi.yaml -o src/api/generated/schema.ts",
    "check:api": "openapi-typescript ../docs/openapi.yaml -o src/api/generated/schema.ts --check",
    "mock": "node mock/server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vitest.json",
    "fmt:check": "oxfmt --config ../.oxfmtrc.json --check src test mock *.config.ts package.json tsconfig*.json"
  },
  "type": "module",
  "private": true
}
