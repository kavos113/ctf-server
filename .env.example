MARIADB_ROOT_PASSWORD=
# Generate a fresh signing key with: openssl rand -hex 32
JWT_KEY_HEX=
JWT_ISSUER=ctf-server
JWT_AUDIENCE=ctf-client
JWT_TTL_SECONDS=3600

# Optional start time (ISO 8601 with timezone); empty means no restriction.
# CONTEST_START_AT=2026-10-01T10:00:00+09:00
CONTEST_START_AT=

# Optional scoring cutoff; answers are still accepted at/after this time.
# CONTEST_END_AT=2026-10-01T18:00:00+09:00
CONTEST_END_AT=
