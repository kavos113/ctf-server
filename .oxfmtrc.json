{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "none",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/out/**",
    "**/dist/**",
    "**/pnpm-lock.yaml",
    "**/LICENSE.md",
    "**/src/**/generated/**"
  ]
}
