{
  "name": "ctf-server-e2etest",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run test/contract.e2e.test.ts",
    "test:unit": "vitest run test/contract.test.ts",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../docs/openapi.yaml -o src/generated/schema.ts",
    "check:api": "openapi-typescript ../docs/openapi.yaml -o src/generated/schema.ts --check",
    "lint:js": "oxlint --config ../.oxlintrc.json --deny-warnings src test *.config.ts",
    "lint": "pnpm lint:js",
    "fmt": "oxfmt --config ../.oxfmtrc.json --write src test *.config.ts package.json tsconfig*.json",
    "fmt:check": "oxfmt --config ../.oxfmtrc.json --check src test *.config.ts package.json tsconfig*.json"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
